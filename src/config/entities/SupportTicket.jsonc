{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_user_id": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "order_problem",
        "deliverer_problem",
        "order_change",
        "question",
        "other"
      ]
    },
    "reason_label": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "waiting_response",
        "resolved",
        "closed"
      ],
      "default": "open"
    },
    "admin_notes": {
      "type": "string"
    },
    "closed_at": {
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "customer_email",
    "reason"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}