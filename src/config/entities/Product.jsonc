{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "video_url": {
      "type": "string"
    },
    "category_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "banner_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "badge_label": {
      "type": "string"
    },
    "badge_color": {
      "type": "string",
      "enum": [
        "red",
        "green",
        "orange",
        "blue",
        "purple",
        "pink"
      ],
      "default": "red"
    },
    "price": {
      "type": "number"
    },
    "cost": {
      "type": "number",
      "default": 0
    },
    "promo_price": {
      "type": "number"
    },
    "price_on_request": {
      "type": "boolean",
      "default": false
    },
    "is_free": {
      "type": "boolean",
      "default": false
    },
    "sku": {
      "type": "string"
    },
    "stock": {
      "type": "number",
      "default": 999
    },
    "show_when_out_of_stock": {
      "type": "boolean",
      "default": false
    },
    "min_quantity": {
      "type": "number",
      "default": 1
    },
    "weight_kg": {
      "type": "number"
    },
    "available_days": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "availability_start": {
      "type": "string"
    },
    "availability_end": {
      "type": "string"
    },
    "variations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "price_modifier": {
                  "type": "number",
                  "default": 0
                },
                "stock": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "addons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "max_qty": {
            "type": "number",
            "default": 1
          }
        }
      }
    },
    "custom_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "select"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "recipe": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ingredient_id": {
            "type": "string"
          },
          "ingredient_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          }
        }
      }
    },
    "prep_time_min": {
      "type": "number"
    },
    "availability_hours": {
      "type": "string"
    },
    "nutritional_info": {
      "type": "string"
    },
    "allergens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "service_duration_min": {
      "type": "number"
    },
    "professional": {
      "type": "string"
    },
    "is_published": {
      "type": "boolean",
      "default": true
    },
    "is_paused": {
      "type": "boolean",
      "default": false
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "rating_avg": {
      "type": "number",
      "default": 0
    },
    "rating_count": {
      "type": "number",
      "default": 0
    },
    "views": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "price"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.is_published": true
            },
            {
              "data.is_paused": {
                "$ne": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
