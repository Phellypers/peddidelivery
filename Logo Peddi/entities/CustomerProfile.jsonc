{
  "name": "CustomerProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "birth_day": {
      "type": "number"
    },
    "birth_month": {
      "type": "number"
    },
    "birth_year": {
      "type": "number"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "delivery_notes": {
      "type": "string"
    },
    "internal_rating": {
      "type": "number",
      "default": 5.0
    },
    "rating_count": {
      "type": "number",
      "default": 0
    },
    "cashback_balance": {
      "type": "number",
      "default": 0
    },
    "cashback_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "add",
              "remove"
            ]
          },
          "amount": {
            "type": "number"
          },
          "reason": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      }
    },
    "total_spent": {
      "type": "number",
      "default": 0
    },
    "total_orders": {
      "type": "number",
      "default": 0
    },
    "last_order_date": {
      "type": "string",
      "format": "date"
    },
    "admin_notes": {
      "type": "string"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}