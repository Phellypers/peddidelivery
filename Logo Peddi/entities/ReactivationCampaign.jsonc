{
  "name": "ReactivationCampaign",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "coupon_code": {
      "type": "string"
    },
    "inactive_days": {
      "type": "number",
      "default": 30
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "last_sent_at": {
      "type": "string"
    },
    "target_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "message"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}