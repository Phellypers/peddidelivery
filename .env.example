# Base44 (backend atual da copia)
VITE_BASE44_APP_ID=
VITE_BASE44_APP_BASE_URL=

# Defina somente quando a integracao existir e estiver aprovada
VITE_BASE44_TOKEN=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_MAPS_PROVIDER_KEY=

# Ferramentas locais de desenvolvimento
VITE_DEV_MOBILE_FRAME=false
VITE_PEDDI_API_URL=http://localhost:3333
# Publicacao Firebase: URL HTTPS publica do backend (nao usar localhost)
PEDDI_HOSTING_API_URL=

# Backend PEDDI
PORT=3333
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
SEED_TEST_PASSWORD=
CLIENT_ORIGIN=http://localhost:5173

# Modulos locais de teste e gestor demo sem expiracao; ignorado em producao
PEDDI_DEMO_MODE=true

# PostgreSQL local: valores privados somente no .env
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=
DATABASE_SSL_MODE=auto
DATABASE_SSL_CA_FILE=
DATABASE_POOL_MAX=5

# Supabase opcional: chaves nao sao exigidas pelo acesso PostgreSQL via pg
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DATABASE_URL=
