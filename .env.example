# Integrações opcionais para ativar futuramente
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_MAPS_PROVIDER_KEY=

# Ferramentas locais de desenvolvimento
VITE_DEV_MOBILE_FRAME=false
VITE_PEDDI_API_URL=http://localhost:3333
# Publicacao Firebase: URL HTTPS publica do backend (nao usar localhost)
PEDDI_HOSTING_API_URL=

# Backend PEDDI
PORT=3333
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
SEED_TEST_PASSWORD=
PRESENTATION_DEMO_PASSWORD=
CLIENT_ORIGIN=http://localhost:5173

# Modulos locais de teste e gestor demo sem expiracao; ignorado em producao
PEDDI_DEMO_MODE=true
# Online: adaptador das telas com permissoes; nao habilita simuladores locais
PEDDI_MVP_MODE=false

# PostgreSQL local: valores privados somente no .env
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=
DATABASE_SSL_MODE=auto
DATABASE_SSL_CA_FILE=
# Render: colar o certificado CA publico completo em uma variavel multiline
DATABASE_SSL_CA=
DATABASE_POOL_MAX=5

# Supabase: SQL via pg nao exige chaves; Storage exige chave privada do backend
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DATABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=peddi-images
